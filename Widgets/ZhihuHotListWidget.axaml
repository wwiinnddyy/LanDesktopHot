<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fi="using:FluentIcons.Avalonia"
             mc:Ignorable="d"
             d:DesignWidth="640"
             d:DesignHeight="640"
             x:Class="LanDesktopHot.Widgets.ZhihuHotListWidget">

    <Border x:Name="RootBorder"
            CornerRadius="24"
            ClipToBounds="True"
            BorderThickness="0"
            Padding="0">
        <Grid>
            <Border x:Name="CardBackground"
                    CornerRadius="24"
                    ClipToBounds="True">
                <Border x:Name="CardBorder"
                        CornerRadius="24"
                        Background="#FCFBFA"
                        BorderBrush="#E8E8E8"
                        BorderThickness="1"
                        Padding="16,14,16,14">
                    <Grid RowDefinitions="Auto,*">
                        <!-- Header -->
                        <Grid x:Name="HeaderGrid"
                              Grid.Row="0"
                              ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="12"
                              Margin="0,0,0,12">
                            <Border x:Name="HeaderIconBadge"
                                    Width="36"
                                    Height="36"
                                    CornerRadius="10"
                                    Background="#140A66FF"
                                    BorderBrush="#200A66FF"
                                    BorderThickness="1">
                                <fi:SymbolIcon x:Name="HeaderIcon"
                                               Symbol="Globe"
                                               IconVariant="Filled"
                                               FontSize="18"
                                               Foreground="#0A66FF"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                            </Border>

                            <StackPanel x:Name="HeaderStack"
                                        Grid.Column="1"
                                        Spacing="2"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="HeaderText"
                                           Text="知乎热榜"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="1"
                                           Foreground="#2B2F35" />
                                <TextBlock x:Name="UpdateTimeText"
                                           Text="更新于 --:--"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Foreground="#7A8088"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="1" />
                            </StackPanel>

                            <Button x:Name="RefreshButton"
                                    Grid.Column="2"
                                    Width="34"
                                    Height="34"
                                    CornerRadius="17"
                                    Background="#14A0A6AF"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    Focusable="False"
                                    VerticalAlignment="Center">
                                <fi:SymbolIcon x:Name="RefreshIcon"
                                               Symbol="ArrowSync"
                                               IconVariant="Regular"
                                               FontSize="16"
                                               Foreground="#626870" />
                            </Button>
                        </Grid>

                        <!-- Hot list content -->
                        <ScrollViewer x:Name="HotListScrollViewer"
                                      Grid.Row="1"
                                      Background="Transparent"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="HotListStackPanel"
                                        Spacing="6" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Border>

            <!-- Loading overlay -->
            <Border x:Name="LoadingHost"
                    IsVisible="False"
                    CornerRadius="24"
                    Background="#140A66FF"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="20,14">
                <StackPanel Orientation="Horizontal"
                            Spacing="10">
                    <fi:SymbolIcon Symbol="ArrowSync"
                                   IconVariant="Regular"
                                   FontSize="18"
                                   Foreground="#0A66FF" />
                    <TextBlock x:Name="LoadingText"
                               Text="正在加载..."
                               FontSize="15"
                               FontWeight="Medium"
                               Foreground="#6B7078"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Error overlay -->
            <Border x:Name="ErrorHost"
                    IsVisible="False"
                    CornerRadius="24"
                    Background="#14FF6B35"
                    BorderBrush="#30FF6B35" BorderThickness="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="20,14">
                <StackPanel Orientation="Horizontal"
                            Spacing="10">
                    <fi:SymbolIcon x:Name="ErrorIcon"
                                   Symbol="Warning"
                                   IconVariant="Filled"
                                   FontSize="18"
                                   Foreground="#FF6B35" />
                    <TextBlock x:Name="ErrorText"
                               Text="加载失败"
                               FontSize="15"
                               FontWeight="Medium"
                               Foreground="#2B2F35"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Empty overlay -->
            <Border x:Name="EmptyHost"
                    IsVisible="False"
                    CornerRadius="24"
                    Background="#0C000000"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="20,14">
                <StackPanel Orientation="Horizontal"
                            Spacing="10">
                    <fi:SymbolIcon Symbol="News"
                                   IconVariant="Regular"
                                   FontSize="18"
                                   Foreground="#7A8088" />
                    <TextBlock x:Name="EmptyText"
                               Text="暂无热榜数据"
                               FontSize="15"
                               FontWeight="Medium"
                               Foreground="#7A8088"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>